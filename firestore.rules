rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreOwner() {
      return request.auth != null
        && request.auth.token.email == 'akeem.fatai15@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public visitors can browse products. Only the owner can create/delete
    // listings; visitors may change only the public engagement counters.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isStoreOwner();
      allow update: if isStoreOwner()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStoreOwner();
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isStoreOwner();
    }

    // Public seller form submissions are private until the owner publishes them.
    match /pendingProductSubmissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.published == false
        && request.resource.data.source == 'public-seller'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.price is string
        && request.resource.data.description is string
        && request.resource.data.imageUrls is list;
      allow read, update, delete: if isStoreOwner();
    }

    match /stockLog/{logId} {
      allow read, write: if isStoreOwner();
    }
    match /activityLog/{logId} {
      allow read, write: if isStoreOwner();
    }
    // Campaigns are private to the verified store owner. Approved campaigns
    // cannot be edited, preserving the review decision.
    function validCampaign(data) {
      return data.keys().hasOnly([
          'productId','productName','productCategory','productPrice','productImage',
          'caption','recipient','status','createdBy','updatedAt','createdAt','events',
          'approvedAt','approvedBy','rejectedAt','rejectedBy','recipientOptIn','consentConfirmedAt'
        ])
        && data.productId is string
        && data.productName is string
        && data.productCategory is string
        && data.productPrice is string
        && data.productImage is string
        && data.caption is string
        && data.caption.size() > 0
        && data.caption.size() <= 5000
        && data.recipient is string
        && data.recipient.size() <= 30
        && data.recipientOptIn is bool
        && (data.recipient == '' || data.recipientOptIn == true)
        && (data.consentConfirmedAt == null || data.consentConfirmedAt is timestamp)
        && data.status in ['draft','pending_approval','approved','rejected']
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.createdAt is timestamp
        && data.events is list
        && data.events.size() <= 1000;
    }

    match /marketingCampaigns/{campaignId} {
      allow read: if isStoreOwner();
      allow create: if isStoreOwner() && validCampaign(request.resource.data)
        && request.resource.data.status in ['draft','pending_approval'];
      allow update: if isStoreOwner()
        && resource.data.status != 'approved'
        && validCampaign(request.resource.data)
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'draft' && request.resource.data.status == 'pending_approval')
          || (resource.data.status == 'pending_approval' && request.resource.data.status in ['approved','rejected','draft'])
          || (resource.data.status == 'rejected' && request.resource.data.status in ['draft','pending_approval'])
        );
      allow delete: if isStoreOwner();
    }

    match /settings/{settingId} {
      allow read, write: if isStoreOwner();
    }

    // Everything else is private unless explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}