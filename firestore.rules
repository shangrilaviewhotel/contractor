rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStoreOwner() {
      return request.auth != null
        && request.auth.token.email == 'akeem.fatai15@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public visitors can browse products. Only the owner can create/delete
    // listings; visitors may change only the public engagement counters.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isStoreOwner();
      allow update: if isStoreOwner()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStoreOwner();
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isStoreOwner();
    }

    // Public seller form submissions are private until the owner publishes them.
    match /pendingProductSubmissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.published == false
        && request.resource.data.source == 'public-seller'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.price is string
        && request.resource.data.description is string
        && request.resource.data.imageUrls is list;
      allow read, update, delete: if isStoreOwner();
    }

    match /stockLog/{logId} {
      allow read, write: if isStoreOwner();
    }
    match /activityLog/{logId} {
      allow read, write: if isStoreOwner();
    }
    match /settings/{settingId} {
      allow read, write: if isStoreOwner();
    }

    // Everything else is private unless explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}